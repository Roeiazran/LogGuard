# Formatting is not a matter of taste in review: run clang-format, then commit.
BasedOnStyle: Google
Language: Cpp
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  # 1. Project headers
  - Regex: '^"logguard/'
    Priority: 1
  # 2. Third-party headers
  - Regex: '^<(gtest|gmock|nlohmann|CLI|spdlog|benchmark|onnxruntime)'
    Priority: 2
  # 3. Standard library
  - Regex: '^<.*>'
    Priority: 3
